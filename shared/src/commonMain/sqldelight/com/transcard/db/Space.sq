CREATE TABLE Space (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    nativeLang TEXT NOT NULL,
    targetLang TEXT NOT NULL,
    createdAt INTEGER NOT NULL
);

selectAll:
SELECT *
FROM Space
ORDER BY createdAt DESC;

selectById:
SELECT *
FROM Space
WHERE id = ?;

insert:
INSERT INTO Space(name, nativeLang, targetLang, createdAt)
VALUES (?, ?, ?, ?);

insertWithId:
INSERT INTO Space(id, name, nativeLang, targetLang, createdAt)
VALUES (?, ?, ?, ?, ?);

deleteById:
DELETE FROM Space
WHERE id = ?;

deleteAll:
DELETE FROM Space;

lastInsertedId:
SELECT last_insert_rowid();
